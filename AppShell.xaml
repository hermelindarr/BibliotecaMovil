<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="BibliotecaMovil.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:BibliotecaMovil.Views"
       Shell.FlyoutBehavior="Disabled"
       Title="Biblioteca Móvil">

    <TabBar>
        <ShellContent Title="Inicio" Icon="inicio.png" Route="inicio"
                      ContentTemplate="{DataTemplate views:InicioPage}" />
        <ShellContent Title="Catálogo" Icon="libros.png" Route="catalogo"
                      ContentTemplate="{DataTemplate views:CatalogoPage}" />
        <ShellContent Title="Préstamos" Icon="prestamos.png" Route="prestamos"
                      ContentTemplate="{DataTemplate views:PrestamosPage}" />
        <ShellContent Title="Usuarios" Icon="usuarios.png" Route="usuarios"
                      ContentTemplate="{DataTemplate views:UsuariosPage}" />
    </TabBar>

</Shell>
