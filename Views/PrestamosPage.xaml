<?xml version="1.0" encoding="utf-8" ?>
<!--
    Préstamos
    · Actividad 3 (Grid): página en filas y formulario de préstamo en 2 columnas.
    · Actividad 2 (HorizontalStackLayout): selector Activos / Historial y control de días.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelos="clr-namespace:BibliotecaMovil.Models"
             x:Class="BibliotecaMovil.Views.PrestamosPage"
             Title="Préstamos">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14" Padding="16,14,16,0">

        <!-- Registrar préstamo (solo administrador) -->
        <Border x:Name="PanelNuevo" Style="{StaticResource Card}">
            <Grid ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="14" RowSpacing="10">

                <Label Grid.ColumnSpan="2" Text="Registrar préstamo" Style="{StaticResource Seccion}" />

                <Label Grid.Row="1" Text="Libro:" Style="{StaticResource Etiqueta}" />
                <Picker x:Name="PkrLibro" Grid.Row="1" Grid.Column="1" Title="Libro disponible" />

                <Label Grid.Row="2" Text="Usuario:" Style="{StaticResource Etiqueta}" />
                <Picker x:Name="PkrUsuario" Grid.Row="2" Grid.Column="1" Title="¿Quién se lo lleva?" />

                <Label Grid.Row="3" Text="Plazo:" Style="{StaticResource Etiqueta}" />
                <HorizontalStackLayout Grid.Row="3" Grid.Column="1" Spacing="12">
                    <Stepper x:Name="StpDias" Minimum="1" Maximum="30" Increment="1" Value="7"
                             VerticalOptions="Center" ValueChanged="OnDiasCambiados" />
                    <Label x:Name="LblDias" Text="7 días" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button x:Name="BtnRegistrar" Grid.Row="4" Grid.ColumnSpan="2"
                        Text="Registrar préstamo" Style="{StaticResource BtnPrincipal}"
                        Clicked="OnRegistrar" />
            </Grid>
        </Border>

        <!-- Selector de vista -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Button x:Name="BtnActivos" Text="Activos" Style="{StaticResource BtnChico}" Clicked="OnVerActivos" />
            <Button x:Name="BtnHistorial" Text="Historial" Style="{StaticResource BtnChicoContorno}" Clicked="OnVerHistorial" />
        </HorizontalStackLayout>

        <!-- Lista -->
        <CollectionView x:Name="ListaPrestamos" Grid.Row="2" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24,40" Spacing="8" HorizontalOptions="Center">
                    <Label Text="📭" FontSize="40" HorizontalOptions="Center" />
                    <Label x:Name="LblVacio" Text="No hay préstamos activos"
                           Style="{StaticResource Seccion}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="modelos:PrestamoDetalle">
                    <Border Style="{StaticResource Card}" Padding="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <Border Grid.RowSpan="2" WidthRequest="44" HeightRequest="58"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                    BackgroundColor="{Binding ColorPortada}" VerticalOptions="Start">
                                <Label Text="{Binding Iniciales}" TextColor="White" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding TituloLibro}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding NombreUsuario}" Style="{StaticResource Subtitulo}" />
                                <Label Text="{Binding Fechas}" Style="{StaticResource Subtitulo}" FontSize="11" />
                            </VerticalStackLayout>

                            <Border Grid.Column="2" Style="{StaticResource Insignia}"
                                    BackgroundColor="{Binding ColorEstado}" VerticalOptions="Start">
                                <Label Text="{Binding EstadoTexto}" Style="{StaticResource TextoInsignia}" />
                            </Border>

                            <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                    Text="Registrar devolución" Style="{StaticResource BtnChico}"
                                    BackgroundColor="{StaticResource Exito}"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding PuedeDevolver}"
                                    Clicked="OnDevolver" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="16" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
